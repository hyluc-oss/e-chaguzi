DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/echaguzi
SESSION_SECRET=replace-with-at-least-32-random-characters
# Persistent local sign-in is disabled unless explicitly enabled.
LOCAL_AUTH_ENABLED=false
# Run npm run auth:provision-local to seed scrypt-hashed accounts into PostgreSQL.
# Example: [{"studentId":"CYB/2024/001","password":"initial-password","gmail":"student@gmail.com"}]
LOCAL_STUDENT_ACCOUNTS=
LOCAL_ADMIN_ID=
LOCAL_ADMIN_PASSWORD=

# Use a Google App Password (with 2-Step Verification), not a Gmail account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
APP_BASE_URL=http://localhost:3000

# Microsoft Entra ID SAML 2.0 service-provider settings
SAML_ENTRY_POINT=https://login.microsoftonline.com/TENANT_ID/saml2
SAML_ISSUER=https://YOUR_PUBLIC_HOST/api/auth/metadata
SAML_CALLBACK_URL=http://localhost:3000/api/auth/callback
SAML_IDP_CERT="-----BEGIN CERTIFICATE-----\nPASTE_ENTRA_SIGNING_CERTIFICATE\n-----END CERTIFICATE-----"
SAML_GROUPS_CLAIM=http://schemas.microsoft.com/ws/2008/06/identity/claims/groups
SAML_ADMIN_GROUP_ID=ENTRA_ADMIN_SECURITY_GROUP_ID
SAML_TRUSTEE_GROUP_ID=ENTRA_KEY_TRUSTEE_SECURITY_GROUP_ID
SAML_FACULTY_CLAIM=faculty
SAML_RESIDENCE_CLAIM=residence
SAML_CLASS_CLAIM=class

# Local Hardhat node and deployed ballot contract
RPC_PROVIDER_URL=http://127.0.0.1:8545
BALLOT_CONTRACT_ADDRESS=
BALLOT_DEPLOYMENT_BLOCK=0
ELECTION_ADMIN_PRIVATE_KEY=
